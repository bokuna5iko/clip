<Application x:Class="Clip.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <SolidColorBrush x:Key="Brush.Window" Color="#16181D"/>
            <SolidColorBrush x:Key="Brush.Rail" Color="#12141A"/>
            <SolidColorBrush x:Key="Brush.Accent" Color="#3B82F6"/>
            <SolidColorBrush x:Key="Brush.RowHover" Color="#242830"/>
            <SolidColorBrush x:Key="Brush.Muted" Color="#9AA3B2"/>
            <SolidColorBrush x:Key="Brush.Border" Color="#2A2D35"/>
            <SolidColorBrush x:Key="Brush.Foreground" Color="#E8EAED"/>

            <Style TargetType="TextBlock">
                <Setter Property="FontFamily" Value="Segoe UI"/>
                <Setter Property="Foreground" Value="{StaticResource Brush.Foreground}"/>
            </Style>

        </ResourceDictionary>
    </Application.Resources>
</Application>
