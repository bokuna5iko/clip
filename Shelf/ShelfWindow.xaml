<Window x:Class="Clip.Shelf.ShelfWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Шкаф"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        Background="#F016181D"
        Foreground="{StaticResource Brush.Foreground}"
        FontFamily="Segoe UI"
        Width="920"
        MinWidth="560"
        StateChanged="Window_StateChanged"
        Loaded="Window_Loaded"
        Closing="Window_Closing"
        PreviewMouseLeftButtonUp="Window_PreviewMouseLeftButtonUp">
    <Border BorderBrush="{StaticResource Brush.Border}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid x:Name="DragBar" Grid.Row="0" Background="#12141A" MouseLeftButtonDown="DragBar_MouseLeftButtonDown"
                  MouseMove="DragBar_MouseMove" MouseLeftButtonUp="DragBar_MouseLeftButtonUp">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Шкаф" Margin="14,8" VerticalAlignment="Center"/>
                <Button x:Name="FullWidthButton" Grid.Column="1" Content="Во весь экран" Margin="8" Padding="10,4"
                        Click="FullWidth_Click" Cursor="Hand"
                        Background="#2A3140" Foreground="{StaticResource Brush.Foreground}"
                        BorderBrush="{StaticResource Brush.Border}"/>
            </Grid>

            <TextBox x:Name="SearchBox" Grid.Row="1" Margin="12,10,12,8" Padding="10,8"
                     Background="#1E2128" Foreground="{StaticResource Brush.Foreground}"
                     BorderBrush="{StaticResource Brush.Border}" CaretBrush="{StaticResource Brush.Foreground}"
                     TextChanged="SearchBox_TextChanged"/>

            <Border x:Name="PinnedBand" Grid.Row="2" AllowDrop="True" Tag="pin"
                    Background="#12141A" Margin="12,0,12,8" CornerRadius="8" Padding="8"
                    PreviewMouseWheel="Band_PreviewMouseWheel"
                    DragOver="Pinned_DragOver" Drop="Pinned_Drop">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Закреп" Foreground="{StaticResource Brush.Muted}" Margin="4,0,0,6"/>
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                        <StackPanel x:Name="PinnedHost" Orientation="Horizontal"/>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <Border x:Name="RecentBand" Grid.Row="3" AllowDrop="True" Tag="recent"
                    Background="#12141A" Margin="12,0,12,8" CornerRadius="8" Padding="8"
                    PreviewMouseWheel="Band_PreviewMouseWheel">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Недавние" Foreground="{StaticResource Brush.Muted}" Margin="4,0,0,6"/>
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                        <StackPanel x:Name="RecentHost" Orientation="Horizontal"/>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <ScrollViewer x:Name="GroupsScroll" Grid.Row="4" Margin="12,0,12,12"
                          HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                          PreviewMouseRightButtonUp="Groups_PreviewMouseRightButtonUp"
                          PreviewMouseLeftButtonDown="Groups_PreviewMouseLeftButtonDown"
                          Tag="group" PreviewMouseWheel="Band_PreviewMouseWheel">
                <Canvas x:Name="GroupsCanvas" Background="#14FFFFFF"/>
            </ScrollViewer>

            <Rectangle x:Name="RightGrip" Grid.RowSpan="5" Width="8" HorizontalAlignment="Right"
                       Fill="Transparent" Cursor="SizeWE"
                       MouseLeftButtonDown="RightGrip_MouseLeftButtonDown"
                       MouseMove="RightGrip_MouseMove"
                       MouseLeftButtonUp="RightGrip_MouseLeftButtonUp"/>
        </Grid>
    </Border>
</Window>
