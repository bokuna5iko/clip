<Window x:Class="Clip.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:Clip.Converters"
        Title="Clip"
        Width="420" Height="640"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        Background="{StaticResource Brush.Window}"
        Foreground="{StaticResource Brush.Foreground}"
        FontFamily="Segoe UI"
        Deactivated="Window_Deactivated"
        Closing="Window_Closing"
        PreviewKeyDown="Window_PreviewKeyDown"
        SourceInitialized="Window_SourceInitialized">
    <Window.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolVis"/>
        <Style x:Key="SearchBox" TargetType="TextBox">
            <Setter Property="Background" Value="#1E2128"/>
            <Setter Property="Foreground" Value="{StaticResource Brush.Foreground}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Brush.Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="CaretBrush" Value="{StaticResource Brush.Foreground}"/>
        </Style>
        <Style x:Key="RowItem" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="6" Padding="8,8">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Brush.RowHover}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2A3140"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Border BorderBrush="{StaticResource Brush.Border}" BorderThickness="1">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="48"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{StaticResource Brush.Rail}">
                <StackPanel VerticalAlignment="Stretch">
                    <Button x:Name="RecentRailButton" Click="RecentRail_Click" ToolTip="Недавние"
                            Background="Transparent" BorderThickness="0" Width="48" Height="48" Cursor="Hand">
                        <Grid>
                            <Border x:Name="RecentAccent" Width="3" HorizontalAlignment="Left"
                                    Background="{StaticResource Brush.Accent}"/>
                            <TextBlock Text="⌂" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{StaticResource Brush.Foreground}"/>
                        </Grid>
                    </Button>
                    <Button x:Name="SettingsRailButton" Click="SettingsRail_Click" ToolTip="Настройки"
                            Background="Transparent" BorderThickness="0" Width="48" Height="48" Cursor="Hand">
                        <Grid>
                            <Border x:Name="SettingsAccent" Width="3" HorizontalAlignment="Left"
                                    Background="{StaticResource Brush.Accent}" Visibility="Collapsed"/>
                            <TextBlock Text="⚙" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{StaticResource Brush.Muted}"/>
                        </Grid>
                    </Button>
                </StackPanel>
            </Border>

            <Grid Grid.Column="1" Margin="14,12,14,12">
                <Grid x:Name="RecentPanel">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="Transparent" Cursor="SizeAll"
                            MouseLeftButtonDown="Header_MouseLeftButtonDown" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="Clip" FontSize="11" Foreground="{StaticResource Brush.Muted}"/>
                            <TextBlock Text="Недавние" FontSize="20" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Border>

                    <Grid Grid.Row="1" Margin="0,0,0,10">
                        <TextBox x:Name="SearchBox" Style="{StaticResource SearchBox}"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Text="Поиск" IsHitTestVisible="False" Margin="12,0,0,0"
                                   VerticalAlignment="Center" Foreground="{StaticResource Brush.Muted}" FontSize="13">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>

                    <Grid Grid.Row="2">
                        <ListBox x:Name="ItemsList" ItemsSource="{Binding ItemsView}"
                                 SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                                 Background="Transparent" BorderThickness="0"
                                 ItemContainerStyle="{StaticResource RowItem}"
                                 MouseLeftButtonUp="ItemsList_MouseLeftButtonUp"
                                 KeyDown="ItemsList_KeyDown"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="40"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Width="36" Height="36" CornerRadius="4" Background="#1E2128"
                                                ClipToBounds="True">
                                            <Grid>
                                                <Image Source="{Binding ImagePath, Converter={x:Static conv:ThumbnailConverter.Instance}}"
                                                       Stretch="UniformToFill"
                                                       Visibility="{Binding Kind, Converter={x:Static conv:KindToImageVisibility.Instance}}"/>
                                                <TextBlock Text="{Binding KindLabel}" HorizontalAlignment="Center"
                                                           VerticalAlignment="Center" FontSize="14"
                                                           Foreground="{StaticResource Brush.Muted}"
                                                           Visibility="{Binding Kind, Converter={x:Static conv:KindToGlyphVisibility.Instance}}"/>
                                            </Grid>
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="10,0,8,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Preview}" FontSize="13" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding SecondaryLine}" FontSize="11"
                                                       Foreground="{StaticResource Brush.Muted}" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                        <Button Grid.Column="2" Content="✕" Width="28" Height="28"
                                                VerticalAlignment="Center"
                                                Background="Transparent" BorderThickness="0"
                                                Foreground="{StaticResource Brush.Muted}"
                                                Cursor="Hand" Opacity="0.7"
                                                Click="DeleteItem_Click" Tag="{Binding}"
                                                ToolTip="Удалить"/>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <TextBlock Text="Скопируйте текст, снимок или файлы — они появятся здесь."
                                   Foreground="{StaticResource Brush.Muted}" FontSize="13"
                                   TextWrapping="Wrap" TextAlignment="Center"
                                   VerticalAlignment="Center" HorizontalAlignment="Center" Margin="16"
                                   Visibility="{Binding HasItems, Converter={StaticResource BoolVis}, ConverterParameter=invert}"/>
                    </Grid>
                </Grid>

                <Grid x:Name="SettingsPanel" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Background="Transparent" Cursor="SizeAll"
                            MouseLeftButtonDown="Header_MouseLeftButtonDown" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="Clip" FontSize="11" Foreground="{StaticResource Brush.Muted}"/>
                            <TextBlock Text="Настройки" FontSize="20" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Border>
                    <StackPanel Grid.Row="1">
                        <TextBlock Text="Горячая клавиша" FontSize="12" Foreground="{StaticResource Brush.Muted}"/>
                        <TextBlock Text="Ctrl+Shift+V" FontSize="15" Margin="0,4,0,20"/>

                        <CheckBox x:Name="StartupCheckBox" Content="Запускать с Windows"
                                  Foreground="{StaticResource Brush.Foreground}"
                                  Margin="0,0,0,20" Checked="StartupCheckBox_Changed" Unchecked="StartupCheckBox_Changed"/>

                        <TextBlock Text="Удалять записи старше" FontSize="12" Foreground="{StaticResource Brush.Muted}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,8">
                            <TextBox x:Name="RetentionDaysBox" Width="64" Style="{StaticResource SearchBox}"
                                     LostFocus="RetentionDaysBox_LostFocus"
                                     PreviewKeyDown="RetentionDaysBox_PreviewKeyDown"/>
                            <TextBlock Text="дней" VerticalAlignment="Center" Margin="8,0,0,0" FontSize="14"/>
                        </StackPanel>
                        <TextBlock Text="0 — не удалять по сроку. Файлы сюда не копируются, сохраняется только путь."
                                   FontSize="12" Foreground="{StaticResource Brush.Muted}"
                                   TextWrapping="Wrap" Margin="0,0,0,20"/>

                        <Button Content="Очистить историю" Padding="12,8" HorizontalAlignment="Left"
                                Background="#2A3140" Foreground="{StaticResource Brush.Foreground}"
                                BorderBrush="{StaticResource Brush.Border}" BorderThickness="1"
                                Cursor="Hand" Click="ClearHistory_Click"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
